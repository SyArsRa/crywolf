# Copy to .env and fill in. .env is gitignored -- never commit a real key.
#
#     cp .env.example .env
#
# Loaded automatically by backend/__init__.py, so the server, the feeder and
# run_observer all pick it up. A real exported env var overrides this file.
# The server reads it at startup: change .env, restart uvicorn.

# Required for live runs. https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional.
# CRYWOLF_MODEL=claude-haiku-4-5     # ladder: haiku -> claude-sonnet-5 -> claude-opus-5
# CRYWOLF_EFFORT=medium              # ignored on models that reject it
# CRYWOLF_MIN_INTERVAL=0             # seconds between calls; raise if rate-limited
